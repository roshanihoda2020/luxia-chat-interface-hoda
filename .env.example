# Copy to .env.development.local for local development. Never commit real .env files.

# Internal Explore "Concept Demo" (presentations only; never set for customer builds).
# When true, open the app with ?explore-demo=concept to switch the demo on for that tab.
VITE_EXPLORE_CONCEPT_DEMO=false

# Optional Cloudflare Turnstile site key for the prototype sign-in. Leave unset locally.
# VITE_TURNSTILE_SITE_KEY=
